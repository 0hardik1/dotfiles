

### Visual configuration
# theme = Tomorrow Night Bright
# theme = tokyonight  # Commented out to allow custom colors
window-theme = system
macos-titlebar-style = tabs

# Custom deep blue color scheme
background = #000011
foreground = #ffffff
cursor-color = #ffffff
selection-background = #4169e1
selection-foreground = #ffffff

# Terminal colors (0-15)
palette = 0=#000000
palette = 1=#ff5555
palette = 2=#50fa7b
palette = 3=#f1fa8c
palette = 4=#bd93f9
palette = 5=#ff79c6
palette = 6=#8be9fd
palette = 7=#f8f8f2
palette = 8=#6272a4
palette = 9=#ff6e6e
palette = 10=#69ff94
palette = 11=#ffffa5
palette = 12=#d6acff
palette = 13=#ff92df
palette = 14=#a4ffff
palette = 15=#ffffff

copy-on-select = true
focus-follows-mouse = true
font-thicken = true
# font-feature = -liga
macos-non-native-fullscreen = true
mouse-hide-while-typing = true

# Enhanced visual settings
font-size = 14
font-family = "JetBrains Mono"
cursor-style = block
cursor-style-blink = true
window-padding-x = 10
window-padding-y = 10
background-opacity = 0.95
unfocused-split-opacity = 0.7

# scrollback-limit in bytes, roughly 125,000 lines
scrollback-limit = 10000000

shell-integration = zsh
shell-integration-features = cursor,sudo,title
# note: see zsh/.zshrc "ghostty integration"

### Keybindings
# super==cmd, alt==opt
# move between tabs is cmd+alt+arrow
keybind = super+alt+left=previous_tab
keybind = super+alt+right=next_tab
# move between panes is cmd+arrow
keybind = super+left=goto_split:previous
keybind = super+right=goto_split:next
# cmd+s sends :w<enter> - so cmd-s works in vim in terminal
keybind = super+s=text:\x1b:w\n
keybind = global:cmd+`=toggle_quick_terminal

# Additional useful keybindings
keybind = super+shift+enter=new_split:right
keybind = super+shift+down=new_split:down
keybind = super+w=close_surface
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+0=reset_font_size

# TODO: search scrollback hack

### Misc settings
desktop-notifications = false
quit-after-last-window-closed = true
window-new-tab-position = end
window-save-state = never
confirm-close-surface = false
auto-update = check

# Performance and behavior improvements
resize-overlay = never
resize-overlay-position = center
mouse-scroll-multiplier = 3
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false

# window-colorspace = srgb
window-colorspace = display-p3